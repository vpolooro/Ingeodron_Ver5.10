# APP_URL: URL pública donde se aloja la aplicación
APP_URL="http://localhost:3000"

# PORT: Puerto interno del servidor Express (por defecto 3000)
PORT=3000

# APP_PORT: Puerto externo expuesto en el host por Docker Compose (por defecto 3000)
APP_PORT=3000

# FILES_ROOT_DIR: Directorio raíz donde se almacenan los archivos en ./storage/<Cliente>/<CodigoVuelo>-<NombreVuelo>/
FILES_ROOT_DIR="./storage"

# SESSION_SECRET: Clave secreta para firmar tokens de sesión y aislar el acceso a archivos de clientes
SESSION_SECRET="clave_secreta_para_firmar_sesiones_ingeodron_cambiar_en_produccion"

# Despliegue Docker desde GitHub (opcionales)
# GIT_BUILD_CONTEXT="https://github.com/vpolooro/Ingeodron_Ver5.10.git#main"
# GIT_REPO_URL="https://github.com/vpolooro/Ingeodron_Ver5.10.git"
# GIT_BRANCH="main"
# GITHUB_TOKEN=""
# AUTO_UPDATE="true"
# DOMAIN="portal.tudominio.es"
